<DxPopup @bind-Visible="_DebtDistributionPopupVisible"
         ShowHeader="false"
         Width="90vw"
         Height="80vh"
         CssClass="debt-distribution-popup"
         CloseOnOutsideClick="true"
         ShowFooter="true">
    <BodyContentTemplate>
        <div id="debt-distribution-print-area" class="p-3 report-print-area" dir="rtl">
            <div class="text-center border-bottom pb-3 mb-3">
                <h5 class="fw-bold mb-2">توزیع بدهی های بیمارستان مسیح دانشوری به اشخاص حقیقی و حقوقی به تفکیک طبقه هزینه</h5>
                <small class="text-muted">تاریخ و ساعت تهیه گزارش: @_DebtDistributionReportDate</small>
            </div>

            <DxGrid Data="@_DebtDistributionList"
                    KeyFieldName="Rec"
                    SizeMode="SizeMode.Small"
                    CssClass="p-0 rtl debt-distribution-grid"
                    AllowSort="true"
                    PageSize="1000"
                    PagerVisible="false"
                    ShowFilterRow="false"
                    ColumnCaptionAlignment="GridTextAlignment.Right"
                    CustomizeSummaryDisplayText="DebtDistribution_CustomizeSummaryDisplayText">
                <Columns>
                    <DxGridDataColumn Caption="ردیف" FieldName="Rec" Width="7%" CaptionAlignment="GridTextAlignment.Right" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn Caption="طبقه هزینه / فعالیت" FieldName="ActivityName" Width="38%" CaptionAlignment="GridTextAlignment.Right" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn Caption="بدهی" FieldName="Debt" Width="18%" DisplayFormat="N0" CaptionAlignment="GridTextAlignment.Right" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn Caption="تعهد برآوردی" FieldName="EstimatedCommitment" Width="18%" DisplayFormat="N0" CaptionAlignment="GridTextAlignment.Right" TextAlignment="GridTextAlignment.Right" />
                    <DxGridDataColumn Caption="بدهی کل" FieldName="TotalDebt" Width="19%" DisplayFormat="N0" CaptionAlignment="GridTextAlignment.Right" TextAlignment="GridTextAlignment.Right" />
                </Columns>
                <TotalSummary>
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Count" FieldName="ActivityName" />
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="Debt" />
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="EstimatedCommitment" />
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="TotalDebt" />
                </TotalSummary>
            </DxGrid>
            <div class="report-description mt-3">مبالغ به ریال است.</div>
        </div>
    </BodyContentTemplate>
    <FooterContentTemplate>
        <DxButton Text="چاپ" IconCssClass="tb-icon tb-icon-print" RenderStyle="ButtonRenderStyle.Primary" Click="@PrintDebtDistributionReport" />
        <DxButton Text="بستن" CssClass="ms-2" Click="@CloseDebtDistributionReport" />
    </FooterContentTemplate>
</DxPopup>

<DxLoadingPanel @bind-Visible="PanelVisible"
                IsContentBlocked="true"
                ApplyBackgroundShading="true"
                IndicatorAreaVisible="true"
                Text="@LoadingPanelText"
                PositionTarget="body"
                TextAlignment="LoadingPanelTextAlignment.Left" />

<Toast @ref="MyToast" />

<script>
    function openInNewTab(url) {
        window.open(url, '_blank');
    }

    // تعداد رکورد هر صفحه با ارتفاع واقعی گرید هماهنگ می‌شود تا اسکرول داخلی ایجاد نشود.
    window.companyRemainGrid = {
        initialize: function (dotNetReference) {
            const updatePageSize = () => {
                const grid = document.querySelector('.company-remain-grid');
                const gridHeight = grid ? grid.getBoundingClientRect().height : window.innerHeight - 185;
                // ارتفاع Toolbar، Header، FilterRow و Pager تقریباً 155px و هر ردیف 32px است.
                const pageSize = Math.max(5, Math.min(50, Math.floor((gridHeight - 155) / 32)));
                dotNetReference.invokeMethodAsync('SetGridPageSize', pageSize);
            };

            updatePageSize();
            window.addEventListener('resize', updatePageSize);
        }
    };

    // فقط محتوای گزارش پاپ‌آپ در یک پنجره موقت چاپ می‌شود؛
    // در نتیجه نسخه تکراری از صفحه اصلی یا لایه‌های پاپ‌آپ چاپ نخواهد شد.
    function printDebtDistributionReport() {
        const report = Array.from(document.querySelectorAll('#debt-distribution-print-area'))
            .find(element => element.offsetParent !== null);
        if (!report) return;

        const printWindow = window.open('', '_blank', 'width=1200,height=800');
        if (!printWindow) return;

        const styles = Array.from(document.querySelectorAll('link[rel="stylesheet"], style'))
            .map(element => element.outerHTML)
            .join('');

        printWindow.document.open();
        printWindow.document.write(`<!doctype html>
            <html dir="rtl">
            <head>
                <meta charset="utf-8" />
                <title>گزارش توزیع بدهی</title>
                ${styles}
                <style>
                    @@page { size: A4 landscape; margin: 12mm; }
                    body { background: #fff !important; margin: 0; font-family: Tahoma, Arial, sans-serif; }
                    .report-print-area { width: 100%; padding: 0 !important; }
                    .dxbl-grid-header-cell { background-color: #176b87 !important; color: #fff !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                </style>
            </head>
            <body>${report.outerHTML}</body>
            </html>`);
        printWindow.document.close();
        printWindow.onload = () => {
            printWindow.focus();
            printWindow.print();
            printWindow.onafterprint = () => printWindow.close();
        };
    }
</script>


<style>
    .alt-item > td:not(.dxbl-grid-empty-cell),
    .alt-item > td:not(.dxbl-grid-indent-cell) {
        background-color: color-mix(in srgb, var(--bs-gray-300), transparent 50%);
    }


    .dxbl-grid-filter-row {
        background-color:  sandybrown !important; /* رنگ دلخواه */
    }

    .debt-distribution-grid .dxbl-grid-header-cell {
        background-color: #176b87;
        color: #fff;
        font-weight: 700;
    }

    .debt-distribution-grid .dxbl-grid-total-summary {
        background-color: #e2f0f4;
        font-weight: 700;
    }

    .report-description { color: #6c757d; font-size: .85rem; }

    /* گرید اصلی همواره فضای باقیمانده از صفحه را می‌گیرد؛ Pager فعلی بدون تغییر باقی می‌ماند. */
    .company-remain-grid {
        height: calc(100vh - 185px) !important;
        min-height: 420px;
        max-height: calc(100vh - 185px) !important;
    }




</style>