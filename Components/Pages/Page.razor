@page "/"

@page "/Page"

@rendermode InteractiveServer

@using DevExpress.Blazor
@using UX.Components.Layout
@layout MainLayout

@inject IServiceProvider ServiceProvider

<div class="content-wrapper container-fluid page-body-wrapper">
