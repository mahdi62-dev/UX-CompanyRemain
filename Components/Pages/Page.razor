                                    PageSizeSelectorVisible="true"
                                    PageSizeSelectorAllRowsItemVisible="true"
                                    ShowGroupPanel="true"
                                    ColumnCaptionAlignment="GridTextAlignment.Right"
                                    EditModelSaving="OnEditModelSaving"
                                    CustomizeElement="Grid_CustomizeElement"
                                    FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
                                    EditNewRowPosition="GridEditNewRowPosition.Top"
                                    ColumnResizeMode="GridColumnResizeMode.NextColumn">

                                <ToolbarTemplate>
                                    <DxToolbar ItemRenderStyleMode="ToolbarRenderStyleMode.Plain">
                                        <DxToolbarItem Text="جدید" BeginGroup="true" Click="NewItem_Click" IconCssClass="grid-toolbar-new" />
                                        <DxToolbarItem Text="انتخاب ستون" Click="ColumnChooserButton_Click" IconCssClass="grid-toolbar-column-chooser" />
                                        <DxToolbarItem Text="خروجی" IconCssClass="grid-toolbar-export">
