                                        </EditSettings>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn Caption="پرداخت 1402" FieldName="P1402" Width="13%" CaptionAlignment="GridTextAlignment.Right" TextAlignment="GridTextAlignment.Right" Visible="false">
                                        <EditSettings>
                                            <DxSpinEditSettings ShowSpinButtons="false" ReadOnly="false" NullText="0" />
                                        </EditSettings>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn Caption="پرداخت 1403" FieldName="P1403" Width="13%" CaptionAlignment="GridTextAlignment.Right" TextAlignment="GridTextAlignment.Right">
                                        <EditSettings>
                                            <DxSpinEditSettings ShowSpinButtons="false" ReadOnly="false" NullText="0" />
                                        </EditSettings>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn Caption="پرداخت 1404" FieldName="P1404" Width="13%" CaptionAlignment="GridTextAlignment.Right" TextAlignment="GridTextAlignment.Right">
                                        <EditSettings>
                                            <DxSpinEditSettings ShowSpinButtons="false" ReadOnly="false" NullText="0" />
                                        </EditSettings>
                                    </DxGridDataColumn>
                                    
                                    <DxGridDataColumn Caption="پرداخت 1405" FieldName="P1405" Width="13%" CaptionAlignment="GridTextAlignment.Right" TextAlignment="GridTextAlignment.Right">
                                        <EditSettings>
                                            <DxSpinEditSettings ShowSpinButtons="false" ReadOnly="false" NullText="0" />
