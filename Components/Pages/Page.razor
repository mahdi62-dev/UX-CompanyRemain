                                            }
                                        </CellDisplayTemplate>
                                    </DxGridDataColumn>


                                    <DxGridDataColumn Caption="نام شرکت" FieldName="Name" Width="20%" CaptionAlignment="GridTextAlignment.Right" TextAlignment="GridTextAlignment.Right">
