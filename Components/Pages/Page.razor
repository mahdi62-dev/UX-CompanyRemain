                                    </DxGridDataColumn>

                                    <DxGridDataColumn Caption="بدهی 1404" FieldName="B1404" Width="13%" CaptionAlignment="GridTextAlignment.Right" TextAlignment="GridTextAlignment.Right">
                                        <EditSettings>
