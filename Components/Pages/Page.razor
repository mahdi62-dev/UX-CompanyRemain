                                            <DxSpinEditSettings ShowSpinButtons="false" ReadOnly="false" NullText="0" />
                                        </EditSettings>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn Caption="بدهی 1403" FieldName="B1403" Width="13%" CaptionAlignment="GridTextAlignment.Right" TextAlignment="GridTextAlignment.Right">
