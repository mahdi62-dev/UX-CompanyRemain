                                            <h6 class="title ps-4">لیست بدهی بیمارستان مسیح دانشوری به شرکت ها</h6>
                                        </div>
                                    </DxToolbarItem>

                                    @*      <DxToolbarItem>
                                        <h6 class="title">@_Date</h6>
                                    </DxToolbarItem> *@

                                </Items>
                            </DxToolbar>
                        </div>

                        <div class="p-2">
                            <DxGrid @ref="@MyGrid"
                                    Data="_CompanyRemainList"
                                    KeyFieldName="Rec"
                                    EditMode="GridEditMode.EditCell"
                                    ShowFilterRow="true"
                                    SizeMode="SizeMode.Small"
                                    TextWrapEnabled="false"
                                    AllowSort="true"
                                    CssClass="p-0 rtl company-remain-grid"
                                    Height="calc(100vh - 185px)"
