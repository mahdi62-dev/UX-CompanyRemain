                                    </DxGridDataColumn>

                                    <DxGridDataColumn Caption="بدهی 1401" FieldName="B1401" Width="13%" CaptionAlignment="GridTextAlignment.Right" TextAlignment="GridTextAlignment.Right" Visible="false">
                                        <EditSettings>
