                                                        ValueFieldName="ID"
                                                        AllowUserInput="true"
                                                        SizeMode="SizeMode.Small" />
                                        </CellEditTemplate>

                                        <CellDisplayTemplate>
                                            @{
                                                var issue = context.DataItem as BLL.Models.CompanyRemain;
                                                if (issue != null)
                                                {
                                                    var selectedItem = _AdrRemainTypeList.FirstOrDefault(x => x.ID == issue.Code);
                                                    <span>@selectedItem?.Name</span>
