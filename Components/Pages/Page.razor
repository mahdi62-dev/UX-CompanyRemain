                                    <DxGridDataColumn Caption="تاریخ تغییر" FieldName="ActionDate" Width="8%" CaptionAlignment="GridTextAlignment.Right" TextAlignment="GridTextAlignment.Right" Visible="false">
                                        <EditSettings>
